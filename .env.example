APP_ENV=dev  # dev | prod

# DB
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<db>

# Auth
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_SECRET_KEY=

# Google / Gemini
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GEMINI_API_KEY=

# Apple
APPLE_CLIENT_ID=

# Kakao
KAKAO_REST_API_KEY=
KAKAO_NATIVE_APP_KEY=

# AI
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Firebase
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Monitoring (dev는 비워도 됨)
SENTRY_DSN=
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# SMS
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_FROM=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
